# Stripe (required for billing routes; safe to leave empty in local dev when not testing checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_NEXT=   # rotation slot

STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Resend (already installed; add API key)
RESEND_API_KEY=
RESEND_FROM=Manuva <hello@manuva.app>

# Vercel Cron auth
CRON_SECRET=

# Developer dashboard (super admin only)
# SUPABASE_PROJECT_REF can be omitted when NEXT_PUBLIC_SUPABASE_URL is set.
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_PAT=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# Public site URL — used in invitation links and Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address that receives a notification email each time someone submits a beta application.
# If unset, applications are still saved to the DB but no notification email is sent.
BETA_NOTIFY_EMAIL=
